diff --git a/config/terapool_spatz4_fpu.mk b/config/terapool_spatz4_fpu.mk
index c1ae2137..65d72d47 100644
--- a/config/terapool_spatz4_fpu.mk
+++ b/config/terapool_spatz4_fpu.mk
@@ -435,6 +435,18 @@ group_mshr_cache_self_inval ?= 1
 # Response cache (MSHR_CACHED): 1 = keep responded entries as a small read-response cache;
 # 0 = MSHR_DRAIN_RESP -> MSHR_IDLE directly, no same-address reuse. Set 0 to remove the
 # cohort-splitting path described in mempool_group_mshr.sv (EnableRespCache).
+# 1, INCLUDING on the packed-A branch. The obvious argument for 0 here is that packed-A deletes
+# the case the cache was built for: at fp16 A[m][n] and A[m][n+1] are the two halves of one 32-bit
+# word, the old kernel fetched that word TWICE (two flh), and the second round arriving after the
+# line had self-invalidated is what split the cohort. Packed-A does one lw and shifts for the high
+# half, so that second round is gone.
+#
+# But the cache has a SECOND consumer that packed-A does not touch: a LATE-ARRIVING core in the
+# same group asking for an A word already fetched. With group_mshr_cache_self_inval=1 and
+# group_mshr_hold_subs_single=4 a CACHED line still serves up to 4 such requesters. Turning the
+# cache off sends them to a fresh entry that rides out group_mshr_serve_timeout (2047) -- the
+# straggler pathology measured 2026-08-22 (harts 0xac/0xad/0xec/0xed/0xee, EVERY load ~2046 cyc).
+# Decision: keep it on. Revisit only with an A/B, same ELF and two images differing in this knob.
 group_mshr_resp_cache ?= 1
 # Cache reuse target (fp16 half-word aliasing): 0 = legacy self-invalidate at hold_subs_*.
 # Non-zero keeps a CACHED line resident until served_cnt reaches it, so the second of the two
@@ -449,6 +461,16 @@ group_mshr_cache_timeout ?= 0
 # high-way lines stay pinned. 1 = per-bank round-robin victim start pointer, advanced past
 # the evicted way only when a reclaim actually fires (invalid-first pass 1 unchanged, hit
 # path untouched). HW: clog2(ways) flops/bank (16x3 = 48 here) + a rotated scan input.
+# Bank-full policy for a MERGEABLE miss. 0 = bypass the MSHR (legacy), 1 = backpressure until a
+# way frees. A bypass splits a cohort: the peers that bypass are served without ever subscribing,
+# so a later member's fresh entry counts subscribers who no longer exist and waits out
+# serve_timeout. Measured over 22 matched sweep pairs: every arm whose baseline had a non-zero
+# bankfull_bypass improved 54-97% under backpressure, and every zero-bypass arm was
+# cycle-identical -- the count is an exact predictor.
+#
+# Reset value AND, on this branch, the value in effect: software owns CSR 11 only where
+# runtime.mk emits MSHR_CFG_BANKFULL_BP.
+group_mshr_bankfull_backpressure ?= 1
 # Bit-identical when 0. Policy change -> A/B measure before flipping the default.
 group_mshr_cache_victim_rr ?= 1
 # CACHED replacement policy. 0 = an idle CACHED entry is not an allocation victim and remains
