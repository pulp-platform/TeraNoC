# ---------------------------------------------------------------------------
# Occupancy / utilization + hold-the-fetch release reason, all groups.
# NOTE: the hand-written `mshr_q_valid_uncached` lines above only exist in builds
# compiled with +define+GROUP_MSHR_DEBUG_TRACE -- on a normal build those adds fail.
# The signals below are ALWAYS available (translate_off debug region, no define
# needed) and mshr_inuse_dbg is the drop-in replacement for mshr_q_valid_uncached.
#   mshr_inuse_*   : entries tracking an outstanding remote miss (real MSHR usage)
#   mshr_cached_*  : entries that are only response-cache ways (reclaimable)
#   mshr_held_*    : in-use subset whose fetch is still withheld (hold-the-fetch)
#   mshr_issue_timeout_* / mshr_issue_subs_* : which entry released its withheld
#                    fetch this cycle, and why (window expired vs subs target met)
# ---------------------------------------------------------------------------
set NumX 4
catch {set NumX [examine -radix dec mempool_pkg::NumX]}
set NumY $NumX
catch {set NumY [examine -radix dec mempool_pkg::NumY]}
for {set gx 0} {$gx < $NumX} {incr gx} {
  for {set gy 0} {$gy < $NumY} {incr gy} {
    set m "sim:/mempool_tb/dut/i_mempool_cluster/gen_groups_x\[${gx}\]/gen_groups_y\[${gy}\]/gen_rtl_group/i_group/i_mempool_group/gen_group_mshr/i_group_mshr"
    if {[catch {examine ${m}/mshr_inuse_cnt_dbg}]} { continue }
    set L "MSHR_X${gx}Y${gy}"
    catch {add wave -noupdate -group $L -radix unsigned ${m}/mshr_inuse_cnt_dbg}
    catch {add wave -noupdate -group $L -radix unsigned ${m}/mshr_cached_cnt_dbg}
    catch {add wave -noupdate -group $L -radix unsigned ${m}/mshr_held_cnt_dbg}
    catch {add wave -noupdate -group $L -radix unsigned ${m}/mshr_valid_cnt_dbg}
    catch {add wave -noupdate -group $L ${m}/mshr_inuse_dbg}
    catch {add wave -noupdate -group $L ${m}/mshr_cached_dbg}
    catch {add wave -noupdate -group $L ${m}/mshr_held_dbg}
    catch {add wave -noupdate -group $L ${m}/mshr_issue_timeout_dbg}
    catch {add wave -noupdate -group $L ${m}/mshr_issue_subs_dbg}
    catch {add wave -noupdate -group $L -radix unsigned ${m}/mshr_issue_timeout_cnt_dbg}
    catch {add wave -noupdate -group $L -radix unsigned ${m}/mshr_issue_subs_cnt_dbg}
    catch {add wave -noupdate -group $L ${m}/req_bankfull_bypass_dbg}
    catch {add wave -noupdate -group $L -radix unsigned ${m}/req_bankfull_bypass_cnt_dbg}
  }
}
