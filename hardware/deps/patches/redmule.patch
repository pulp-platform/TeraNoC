-  .flags_o             ( flags_o.z_stream_sink_flags )
+  .flags_o             ( z_sink_flags                 )
 );
 
+// The sink's done pulse only means that every Z store has entered i_z_fifo.
+// Keep the job active until that FIFO drains and all issued stores are
+// acknowledged; otherwise a following software clear can discard queued stores
+// or let the next job observe incomplete output.
+assign z_store_req_fire = virt_tcdm_rob[3].req && virt_tcdm_rob[3].gnt;
+assign z_store_rsp_fire = virt_tcdm_rob[3].r_valid && virt_tcdm_rob[3].r_ready;
+
+always_ff @(posedge clk_i or negedge rst_ni) begin : z_store_outstanding_reg
+  if (!rst_ni) begin
+    z_store_outstanding_q <= '0;
+  end else begin
+    case ({z_store_req_fire, z_store_rsp_fire})
+      2'b10: z_store_outstanding_q <= z_store_outstanding_q + 1'b1;
+      2'b01: begin
+        if (z_store_outstanding_q != '0) begin
+          z_store_outstanding_q <= z_store_outstanding_q - 1'b1;
+        end
+      end
+      default: z_store_outstanding_q <= z_store_outstanding_q;
+    endcase
+  end
+end
+
+`ifndef SYNTHESIS
+always_ff @(posedge clk_i) begin : z_store_outstanding_assert
+  if (rst_ni) begin
+    assert (!(z_store_rsp_fire && !z_store_req_fire && (z_store_outstanding_q == '0)))
+      else $error("RedMulE Z-store response arrived with no outstanding store");
+  end
+end
+`endif
+
+assign z_sink_done = (z_sink_done_pending_q || z_sink_flags.done) &&
+                     z_fifo_flags.empty && (z_store_outstanding_q == '0);
+
+always_ff @(posedge clk_i or negedge rst_ni) begin : z_sink_done_pending_reg
+  if (!rst_ni) begin
+    z_sink_done_pending_q <= 1'b0;
+  end else if (clear_i) begin
+    z_sink_done_pending_q <= 1'b0;
+  end else if (z_sink_done) begin
+    z_sink_done_pending_q <= 1'b0;
+  end else if (z_sink_flags.done) begin
+    z_sink_done_pending_q <= 1'b1;
+  end
+end
+
+always_comb begin : z_sink_flags_comb
+  flags_o.z_stream_sink_flags = z_sink_flags;
+  flags_o.z_stream_sink_flags.done = z_sink_done;
+end
