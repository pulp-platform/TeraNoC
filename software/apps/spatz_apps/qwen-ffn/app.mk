# ---- Fused Qwen FFN (qwen-ffn): gate+up -> SwiGLU -> down in one timed region ----------------
# Included by ../Makefile before its $(BINARIES) rule. docs/qwen3_8_27b/ffn_fused_plan.md.
#
#   make qwen-ffn config=terapool_spatz4_fpu icache_warmup=1 l1_bank_size=4096 l2_size=536870912 ffn_b=16
#   make qwen-ffn ... ffn_b=4 ffn_h=512 ffn_i=2048 ffn_check=1        # end-to-end check, small dims
#
# The two phases are phase.c compiled twice (phase_gu.c, phase_dn.c), each with its own generated
# headers in gu/data/ and dn/data/ on its include path; data/ holds what they share.
ffn_saved_goal_fused := $(.DEFAULT_GOAL)

ffn_b       ?= 1
ffn_h       ?= 4096         # hidden: gate+up's K, down's P
ffn_i       ?= 16384        # FFN intermediate: gate+up's P, down's K
ffn_check   ?= 0            # 1 = end-to-end multi-hot check (preloads X, Wg, Wu, Wd)
ffn_gu_kt_max ?= 640
ffn_dn_kt_max ?= $(ffn_i)
ffn_kgroup  ?= auto         # K split across groups (both phases): auto | 0 | 1
ffn_rc_group ?= 4

ifneq ($(filter qwen-ffn,$(MAKECMDGOALS)),)
ifneq ($(strip $(l1_bank_size)),4096)
$(error qwen-ffn: pass l1_bank_size=4096 (got '$(strip $(l1_bank_size))'))
endif
ifneq ($(strip $(l2_size)),536870912)
$(error qwen-ffn: pass l2_size=536870912 (got '$(strip $(l2_size))'))
endif
QWEN_EXTRA_OBJS += qwen-ffn/phase_gu.c.o qwen-ffn/phase_dn.c.o
ifeq ($(ffn_check),1)
QWEN_EXTRA_OBJS += qwen-ffn/data/ffn_operands.S.o
endif
endif

FFN_DIR := qwen-ffn
ffn_kg_req := $(if $(filter auto,$(ffn_kgroup)),-1,$(ffn_kgroup))

# One shape header per phase. $(1) = phase dir, then M N P stages check kt_max.
define ffn_shape_rule
$(FFN_DIR)/$(1)/data/qwen_shape.h: FORCE
	@mkdir -p $$(@D)
	@{ \
	  echo '// GENERATED by qwen-ffn/app.mk -- do not hand-edit.'; \
	  echo '#ifndef QWEN_SHAPE_H'; \
	  echo '#define QWEN_SHAPE_H'; \
	  echo '#define FFN_BUILT_FOR "$(config) cores=$(num_cores) groups=$(num_groups) l1_bank=$(l1_bank_size) l2=$(l2_size) b=$(ffn_b) h=$(ffn_h) i=$(ffn_i)"'; \
	  echo '#define GEMM_M $(2)'; \
	  echo '#define GEMM_N $(3)'; \
	  echo '#define GEMM_P $(4)'; \
	  echo '#define GEMM_ELEM_BYTES 2'; \
	  echo '#define QWEN_STAGES_N $(5)u'; \
	  echo '#define QWEN_CHECK $(6)'; \
	  echo '#define QWEN_PRELOAD $(ffn_check)'; \
	  echo '#define QWEN_INIT 0'; \
	  echo '#define QWEN_REPEATS 1'; \
	  echo '#define QWEN_DMA_CORE 0u'; \
	  echo '#define QWEN_KT_REQ 0'; \
	  echo '#define QWEN_KT_MAX $(7)'; \
	  echo '#define GEMM_KS_PREFER_MAX 1'; \
	  echo '#define QWEN_SPAN_ALIGN_DEFAULT 1'; \
	  echo '#define QWEN_PT_REQ 0'; \
	  echo '#define MATMUL_DECODE_SPLIT 1'; \
	  echo '#define GEMM_DECODE_RC_PER_GROUP $(ffn_rc_group)'; \
	  echo '#define QWEN_WPAD_DEFAULT 1'; \
	  echo '#define QWEN_KSPLIT_REQ 0'; \
	  echo '#define QWEN_SWIGLU 0'; \
	  echo '#define QWEN_ACC32 0'; \
	  echo '#define FFN_KSPLIT_XGROUP_REQ $(ffn_kg_req)'; \
	  echo '#define FFN_PRIME_SPLIT_REQ 1'; \
	  echo '#define FFN_HPAD_REQ -1'; \
	  echo '#define FFN_GU_PT_REQ 0'; \
	  echo '#define FFN_GU_WPAD_REQ -1'; \
	  echo '#endif'; \
	} > $$@.tmp
	@if cmp -s $$@.tmp $$@; then rm -f $$@.tmp; else mv $$@.tmp $$@; fi
endef
$(eval $(call ffn_shape_rule,gu,$(ffn_b),$(ffn_h),$(ffn_i),2,0,$(ffn_gu_kt_max)))
$(eval $(call ffn_shape_rule,dn,$(ffn_b),$(ffn_i),$(ffn_h),1,$(ffn_check),$(ffn_dn_kt_max)))

FFN_HOST_CC ?= cc
FFN_HOST = $(FFN_HOST_CC) -O1 -I$(RUNTIME_DIR) -I$(FFN_DIR)/$(1) -I$(FFN_DIR) $(DEFINES)
FFN_LAYOUT_DEPS = $(FFN_DIR)/qwen_layout.h $(RUNTIME_DIR)/gemm_config.h $(RUNTIME_DIR)/gemm_burst.h

# Every legal (KT, PT) of one phase, then the joint choice for both under one L1 budget.
$(FFN_DIR)/%/data/cands.txt: $(FFN_DIR)/%/data/qwen_shape.h $(FFN_LAYOUT_DEPS) $(FFN_DIR)/script/gen_cands.c
	$(call FFN_HOST,$*) $(FFN_DIR)/script/gen_cands.c -o $(@D)/gen_cands
	$(@D)/gen_cands > $@.tmp && mv $@.tmp $@

$(FFN_DIR)/data/ffn_joint.h: $(FFN_DIR)/gu/data/cands.txt $(FFN_DIR)/dn/data/cands.txt $(FFN_DIR)/script/gen_joint.c
	@mkdir -p $(@D)
	$(FFN_HOST_CC) -O1 $(FFN_DIR)/script/gen_joint.c -o $(@D)/gen_joint -lm
	$(@D)/gen_joint $(FFN_DIR)/gu/data/cands.txt $(FFN_DIR)/dn/data/cands.txt \
		$(FFN_DIR)/gu/data/qwen_tiles.h $(FFN_DIR)/dn/data/qwen_tiles.h $@
$(FFN_DIR)/gu/data/qwen_tiles.h $(FFN_DIR)/dn/data/qwen_tiles.h: $(FFN_DIR)/data/ffn_joint.h

# What gate+up must know of down: H's layout and down's check pattern.
$(FFN_DIR)/data/ffn_shared.h: $(FFN_DIR)/dn/data/qwen_tiles.h $(FFN_LAYOUT_DEPS) $(FFN_DIR)/script/gen_shared.c
	$(call FFN_HOST,dn) $(FFN_DIR)/script/gen_shared.c -o $(@D)/gen_shared
	$(@D)/gen_shared > $@.tmp && mv $@.tmp $@

$(FFN_DIR)/%/data/qwen_hash.h: $(FFN_DIR)/%/data/qwen_tiles.h $(FFN_LAYOUT_DEPS) \
	$(FFN_DIR)/script/gen_hash.c $(RUNTIME_DIR)/gemm_hash.h
	$(call FFN_HOST,$*) $(FFN_DIR)/script/gen_hash.c -o $(@D)/gen_hash
	$(@D)/gen_hash > $@

# Check builds: the operand images, preloaded in L2 (script/gen_operands_{gu,dn}.c).
$(FFN_DIR)/gu/data/operands.done: $(FFN_DIR)/gu/data/qwen_tiles.h $(FFN_DIR)/data/ffn_shared.h \
	$(FFN_LAYOUT_DEPS) $(FFN_DIR)/qwen_pattern.h $(FFN_DIR)/script/gen_operands_gu.c
	$(call FFN_HOST,gu) -O2 $(FFN_DIR)/script/gen_operands_gu.c -o $(@D)/gen_operands -lm
	$(@D)/gen_operands $(abspath $(@D)) && touch $@
$(FFN_DIR)/dn/data/operands.done: $(FFN_DIR)/dn/data/qwen_tiles.h \
	$(FFN_LAYOUT_DEPS) $(FFN_DIR)/qwen_pattern.h $(FFN_DIR)/script/gen_operands_dn.c
	$(call FFN_HOST,dn) -O2 $(FFN_DIR)/script/gen_operands_dn.c -o $(@D)/gen_operands -lm
	$(@D)/gen_operands $(abspath $(@D)) && touch $@
$(FFN_DIR)/data/ffn_operands.S: $(FFN_DIR)/gu/data/operands.done $(FFN_DIR)/dn/data/operands.done
	@{ echo '// GENERATED by qwen-ffn/app.mk -- do not hand-edit.'; \
	   echo '  .section .l2, "a", @progbits'; \
	   for s in gu/gu_w_l2 gu/gu_x_l2 dn/dn_w_l2; do \
	     echo "  .balign $$(cat $(FFN_DIR)/$${s%%/*}/data/align.txt)"; \
	     echo "  .globl $${s##*/}"; echo "$${s##*/}:"; \
	     echo "  .incbin \"$(abspath $(FFN_DIR))/$${s%%/*}/data/$${s##*/}.bin\""; \
	   done; } > $@
$(FFN_DIR)/data/ffn_operands.S.o: $(FFN_DIR)/data/ffn_operands.S
	$(RISCV_CC) $(RISCV_CCFLAGS) -c $< -o $@

FFN_GEN = $(FFN_DIR)/data/ffn_joint.h $(FFN_DIR)/data/ffn_shared.h
$(FFN_DIR)/phase_gu.c.o: RISCV_CCFLAGS += -I$(abspath $(FFN_DIR)/gu)
$(FFN_DIR)/phase_dn.c.o: RISCV_CCFLAGS += -I$(abspath $(FFN_DIR)/dn)
$(FFN_DIR)/phase_gu.c.o: $(FFN_DIR)/gu/data/qwen_hash.h $(FFN_GEN) $(FFN_DIR)/phase.c \
	$(FFN_DIR)/ffn.h $(FFN_DIR)/swiglu.h $(FFN_DIR)/kernel/qwen-fmatmul.c $(FFN_LAYOUT_DEPS)
$(FFN_DIR)/phase_dn.c.o: $(FFN_DIR)/dn/data/qwen_hash.h $(FFN_GEN) $(FFN_DIR)/phase.c \
	$(FFN_DIR)/ffn.h $(FFN_DIR)/kernel/qwen-fmatmul.c $(FFN_LAYOUT_DEPS)
$(FFN_DIR)/main.c.o: $(FFN_GEN) $(FFN_DIR)/ffn.h

.DEFAULT_GOAL := $(ffn_saved_goal_fused)
