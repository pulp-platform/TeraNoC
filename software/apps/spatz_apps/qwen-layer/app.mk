#
# ---- Qwen GDN mixer block (qwen-layer): qkvz -> mixer -> o-proj in one timed region ------
# Included by ../Makefile before its $(BINARIES) rule. docs/qwen3_8_27b/mixer_plan.md, step 4.
#
#   make qwen-layer config=terapool_spatz4_fpu icache_warmup=1 l1_bank_size=4096 \
#        l2_size=536870912 ql_b=4 [ql_stream=1]
#
# Two projection phases, qwen-common/qwen_phase.c compiled twice (phase_qz.c, phase_op.c), each
# with its generated headers in qz/data/ and op/data/; data/ holds what the app shares.
ql_saved_goal := $(.DEFAULT_GOAL)

ql_b       ?= 1
ql_mixer   ?= gdn     # gdn (Gated DeltaNet) | attn (gated attention)
ql_s       ?= 2048    # attention: KV history length
ql_stream  ?= 1       # 1: GDN state streamed from L2 (mixer_plan D1); 0: resident in L1
ql_check   ?= 0
ql_ffn     ?= 0       # 1: the whole GDN layer -- the block, then the FFN (gate+up, down)
# 1: the timed region is the mixer alone (waveform runs reach it at once); its inputs are left as
# L1 holds them, values are not a goal. Needs ql_ffn=0 and ql_check=0.
ql_mixer_only ?= 0
# Tokens per sequence per step (MTP: 1 + draft tokens verified together). The projections and the
# FFN see ql_b * ql_t rows; the mixers ql_b sequences of ql_t tokens each.
ql_t       ?= 1
# Attention: tokens that share one core's K/V tile (the rest get their own cores; ql_t / ql_tg
# core sets per (sequence, KV head)). L1 bounds it: each shared token adds 6 q heads + an accumulator.
ql_tg      ?= 1
# Attention: the ql_t / ql_tg token groups of a (sequence, KV head) share ONE copy of its K/V
# (ql_ks = that count, adjacent cores, each holding 1/ql_ks of the head dims and reading the
# rest from its neighbours), instead of each group streaming its own copy (1).
ql_ks      ?= 1
# GDN: 1 = the chunked delta rule (all ql_t tokens in one pass over the state, columns split over
# ql_cs cores; 0 = the widest split that fits), 0 = the per-token kernel.
ql_gck     ?= 1
ql_cs      ?= 0
# GDN value self-test (mixer only, real exp): two steps against script/gen_gchk.py's reference.
ql_gchk    ?= 0
# GDN a,b stage: 1 = each task starts its K walk at a per-core chunk (spreads the tiles hit at
# once), 0 = every task from chunk 0 in lockstep.
ql_abrot   ?= 1
# 1: exp is one FPU op standing in for an exponent instruction (qc_vec.h QC_EXP_FAKE; values wrong,
# timing only); 0: the FP-only polynomial.
ql_exp_fake ?= 1
# 1: non-linear benchmark -- the whole layer (ql_ffn=1, T=1) with the projections' tiles and the
# mixer skipped; norms, epilogues and handovers timed in parts ([QLP], script/nonlin_parts.py).
ql_proj_skip ?= 0
# Attention: run only the first k rounds (a whole number of problems per core) and extrapolate.
ql_rounds_run ?= 0
# GDN in-projection epilogue: 1 = q k v z leave as one vector store per strip and destination
# (phase_qz.c), 0 = one scalar store per value and destination.
ql_vscat ?= 0
ql_rows    := $(shell echo $$(( $(ql_b) * $(ql_t) )))
# 1: every projection streams ONE shared L2 weight region (perf builds: the values are never
# used and L2 is flat SRAM, so the timing is the same). A whole layer's weights (~560 MiB) do not
# fit the 512 MiB L2 of the current RTL images otherwise.
ql_wshare  ?= $(ql_ffn)
ql_qz_kt_max ?= 640
ql_op_kt_max ?= 6144
ql_gu_kt_max ?= 640
ql_dn_kt_max ?= 16384
ql_kgroup  ?= auto    # K split across groups (both phases): auto | 0 | 1
ql_rc_group ?= 4

QL_DIR := qwen-layer
QL_COMMON := qwen-common
QL_FFN := qwen-ffn
ql_kg_req := $(if $(filter auto,$(ql_kgroup)),-1,$(ql_kgroup))

ifneq ($(filter qwen-layer,$(MAKECMDGOALS)),)
ifneq ($(strip $(l1_bank_size)),4096)
$(error qwen-layer: pass l1_bank_size=4096 (got '$(strip $(l1_bank_size))'))
endif
ifeq ($(ql_mixer),attn)
QWEN_EXTRA_OBJS += $(QL_DIR)/phase_qa.c.o $(QL_DIR)/phase_op.c.o $(QL_DIR)/mixer_attn.c.o
else
QWEN_EXTRA_OBJS += $(QL_DIR)/phase_qz.c.o $(QL_DIR)/phase_op.c.o $(QL_DIR)/mixer_gdn.c.o
endif
QWEN_EXTRA_OBJS += $(QL_DIR)/norms.c.o
ifeq ($(ql_ffn),1)
QWEN_EXTRA_OBJS += $(QL_DIR)/phase_gu.c.o $(QL_DIR)/phase_dn.c.o
endif
ifeq ($(ql_wshare),1)
QWEN_EXTRA_OBJS += $(QL_DIR)/data/ql_wl2.S.o
endif
endif
QL_IN := $(if $(filter attn,$(ql_mixer)),qa,qz)
QL_PHASES := $(QL_IN) op $(if $(filter 1,$(ql_ffn)),gu dn)

# One shape header per phase. $(1) = phase dir, then M N P kt_max.
define ql_shape_rule
$(QL_DIR)/$(1)/data/qwen_shape.h: FORCE
	@mkdir -p $$(@D)
	@{ \
	  echo '// GENERATED by qwen-layer/app.mk -- do not hand-edit.'; \
	  echo '#ifndef QWEN_SHAPE_H'; \
	  echo '#define QWEN_SHAPE_H'; \
	  echo '#define GEMM_M $(2)'; \
	  echo '#define GEMM_N $(3)'; \
	  echo '#define GEMM_P $(4)'; \
	  echo '#define GEMM_ELEM_BYTES 2'; \
	  echo '#define QWEN_STAGES_N $(6)u'; \
	  echo '#define QWEN_CHECK 0'; \
	  echo '#define QWEN_PRELOAD $(ql_wshare)'; \
	  echo '#define QWEN_INIT 0'; \
	  echo '#define QWEN_REPEATS 1'; \
	  echo '#define QWEN_DMA_CORE 0u'; \
	  echo '#define QWEN_KT_REQ 0'; \
	  echo '#define QWEN_KT_MAX $(5)'; \
	  echo '#define GEMM_KS_PREFER_MAX 1'; \
	  echo '#define QWEN_SPAN_ALIGN_DEFAULT 1'; \
	  echo '#define QWEN_PT_REQ 0'; \
	  echo '#define MATMUL_DECODE_SPLIT 1'; \
	  echo '#define GEMM_DECODE_RC_PER_GROUP $(ql_rc_group)'; \
	  echo '#define QWEN_WPAD_DEFAULT 1'; \
	  echo '#define QWEN_KSPLIT_REQ 0'; \
	  echo '#define QWEN_SWIGLU 0'; \
	  echo '#define QWEN_ACC32 0'; \
	  echo '#define FFN_KSPLIT_XGROUP_REQ $(ql_kg_req)'; \
	  echo '#define FFN_PRIME_SPLIT_REQ 1'; \
	  echo '#define FFN_HPAD_REQ -1'; \
	  echo '#define FFN_GU_PT_REQ 0'; \
	  echo '#define FFN_GU_WPAD_REQ -1'; \
	  echo '#endif'; \
	} > $$@.tmp
	@if cmp -s $$@.tmp $$@; then rm -f $$@.tmp; else mv $$@.tmp $$@; fi
endef
$(eval $(call ql_shape_rule,qz,$(ql_rows),4096,16384,$(ql_qz_kt_max),1))
$(eval $(call ql_shape_rule,qa,$(ql_rows),4096,14336,$(ql_qz_kt_max),1))
$(eval $(call ql_shape_rule,op,$(ql_rows),6144,4096,$(ql_op_kt_max),1))
$(eval $(call ql_shape_rule,gu,$(ql_rows),4096,16384,$(ql_gu_kt_max),2))
$(eval $(call ql_shape_rule,dn,$(ql_rows),16384,4096,$(ql_dn_kt_max),1))

$(QL_DIR)/data/ql_knobs.h: FORCE
	@mkdir -p $(@D)
	@{ \
	  echo '// GENERATED by qwen-layer/app.mk -- do not hand-edit.'; \
	  echo '#ifndef QL_KNOBS_H'; \
	  echo '#define QL_KNOBS_H'; \
	  echo '#define QL_BUILT_FOR "$(config) cores=$(num_cores) l1_bank=$(l1_bank_size) l2=$(l2_size) b=$(ql_b) mixer=$(ql_mixer) s=$(ql_s) stream=$(ql_stream) ffn=$(ql_ffn) mixer_only=$(ql_mixer_only) t=$(ql_t) tg=$(ql_tg) ks=$(ql_ks) gck=$(ql_gck) cs=$(ql_cs) gchk=$(ql_gchk) abrot=$(ql_abrot) exp_fake=$(ql_exp_fake) proj_skip=$(ql_proj_skip) rounds_run=$(ql_rounds_run) vscat=$(ql_vscat)"'; \
	  echo '#define QL_B $(ql_b)u'; \
	  echo '#define QL_TOK $(ql_t)u'; \
	  echo '#define QL_TG $(ql_tg)u'; \
	  echo '#define QL_KS $(ql_ks)u'; \
	  echo '#define QL_GCK $(ql_gck)'; \
	  echo '#define QL_CS_KNOB $(ql_cs)u'; \
	  echo '#define QL_GCHK $(ql_gchk)'; \
	  echo '#define QL_ABROT $(ql_abrot)'; \
	  echo '#define QL_ROWS ($(ql_b)u * $(ql_t)u)'; \
	  echo '#ifndef QC_EXP_FAKE'; \
	  echo '#if defined(QL_COMBINE_CMP) || $(ql_gchk)'; \
	  echo '#define QC_EXP_FAKE 0  /* the self-tests compare values */'; \
	  echo '#else'; \
	  echo '#define QC_EXP_FAKE $(ql_exp_fake)'; \
	  echo '#endif'; \
	  echo '#endif'; \
	  echo '#define QL_STREAM $(ql_stream)'; \
	  echo '#define QL_CHECK $(ql_check)'; \
	  echo '#define QL_FFN $(ql_ffn)'; \
  echo '#define QL_PROJ_SKIP $(ql_proj_skip)'; \
  echo '#define QL_ROUNDS_RUN $(ql_rounds_run)u'; \
  echo '#define QL_VSCAT $(ql_vscat)'; \
	  echo '#define QL_MIXER_ONLY $(ql_mixer_only)'; \
	  echo '#define QL_ATTN $(if $(filter attn,$(ql_mixer)),1,0)'; \
	  echo '#define QL_S $(ql_s)u'; \
	  echo '#endif'; \
	} > $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; fi

QL_HOST_CC ?= cc
QL_HOST = $(QL_HOST_CC) -O1 -DQC_HOST -I$(RUNTIME_DIR) -I$(QL_DIR)/$(1) -I$(QL_DIR) \
	-I$(QL_COMMON) -I$(QL_COMMON)/script $(DEFINES)
QL_LAYOUT_DEPS = $(QL_COMMON)/qwen_layout.h $(RUNTIME_DIR)/gemm_config.h $(RUNTIME_DIR)/gemm_burst.h

# Every legal (KT, PT) of one phase (qwen-ffn's generator), then the joint choice with the mixer.
$(QL_DIR)/%/data/cands.txt: $(QL_DIR)/%/data/qwen_shape.h $(QL_LAYOUT_DEPS) $(QL_DIR)/script/gen_cands.c \
		$(QL_DIR)/data/ql_knobs.h  # the mesh (L1 size) is in the knobs, not the shape
	$(call QL_HOST,$*) $(QL_DIR)/script/gen_cands.c -o $(@D)/gen_cands
	$(@D)/gen_cands > $@.tmp && mv $@.tmp $@

$(QL_DIR)/data/reserve.txt: $(QL_DIR)/data/ql_knobs.h $(QL_DIR)/layer.h \
	$(QL_COMMON)/qc_gdn.h $(QL_COMMON)/qc_layout.h $(QL_DIR)/script/gen_reserve.c
	$(call QL_HOST,$(QL_IN)) $(QL_DIR)/script/gen_reserve.c -o $(@D)/gen_reserve
	$(@D)/gen_reserve > $@.tmp && mv $@.tmp $@

$(QL_DIR)/data/ql_joint.h: $(foreach p,$(QL_PHASES),$(QL_DIR)/$(p)/data/cands.txt) \
	$(QL_DIR)/data/reserve.txt $(QL_DIR)/script/gen_joint.c $(QL_DIR)/data/ql_knobs.h
	$(QL_HOST_CC) -O1 $(QL_DIR)/script/gen_joint.c -o $(@D)/gen_joint -lm
	$(@D)/gen_joint $@ $$(cat $(QL_DIR)/data/reserve.txt) \
		$(foreach p,$(QL_PHASES),$(p) $(QL_DIR)/$(p)/data/cands.txt $(QL_DIR)/$(p)/data/qwen_tiles.h)
$(foreach p,$(QL_PHASES),$(QL_DIR)/$(p)/data/qwen_tiles.h): $(QL_DIR)/data/ql_joint.h

$(QL_DIR)/data/ql_a_qz.h: $(QL_DIR)/$(QL_IN)/data/qwen_tiles.h $(QL_LAYOUT_DEPS) $(QL_DIR)/script/gen_a.c
	$(call QL_HOST,$(QL_IN)) $(QL_DIR)/script/gen_a.c -o $(@D)/gen_a_qz
	$(@D)/gen_a_qz QL_X > $@.tmp && mv $@.tmp $@
$(QL_DIR)/data/ql_a_op.h: $(QL_DIR)/op/data/qwen_tiles.h $(QL_LAYOUT_DEPS) $(QL_DIR)/script/gen_a.c
	$(call QL_HOST,op) $(QL_DIR)/script/gen_a.c -o $(@D)/gen_a_op
	$(@D)/gen_a_op QL_O > $@.tmp && mv $@.tmp $@

$(QL_DIR)/%/data/qwen_hash.h: $(QL_DIR)/%/data/qwen_tiles.h $(QL_LAYOUT_DEPS) \
	$(QL_COMMON)/script/gen_hash.c $(RUNTIME_DIR)/gemm_hash.h
	$(call QL_HOST,$*) $(QL_COMMON)/script/gen_hash.c -o $(@D)/gen_hash
	$(@D)/gen_hash > $@

# Without the FFN the layer headers exist but say so (and must not depend on the FFN phases'
# tiles: a fresh checkout has none, and nothing generates them at ql_ffn=0).
ifeq ($(ql_ffn),1)
$(QL_DIR)/data/ql_a_dn.h: $(QL_DIR)/dn/data/qwen_tiles.h $(QL_LAYOUT_DEPS) $(QL_DIR)/script/gen_a.c
	$(call QL_HOST,dn) $(QL_DIR)/script/gen_a.c -o $(@D)/gen_a_dn
	$(@D)/gen_a_dn QL_FH > $@.tmp && mv $@.tmp $@
$(QL_DIR)/data/ql_a_gu.h: $(QL_DIR)/gu/data/qwen_tiles.h $(QL_LAYOUT_DEPS) $(QL_DIR)/script/gen_a.c
	$(call QL_HOST,gu) $(QL_DIR)/script/gen_a.c -o $(@D)/gen_a_gu
	$(@D)/gen_a_gu QL_GX > $@.tmp && mv $@.tmp $@
else
$(QL_DIR)/data/ql_a_dn.h $(QL_DIR)/data/ql_a_gu.h: FORCE
	@mkdir -p $(@D)
	@echo '// no FFN phases (ql_ffn=0)' > $@.tmp; if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; fi
endif

# The shared weight region: the largest phase's bytes, every phase's <pfx>w_l2 an alias of it.
$(QL_DIR)/%/data/wbytes.txt: $(QL_DIR)/%/data/qwen_tiles.h $(QL_LAYOUT_DEPS) $(QL_DIR)/script/gen_wbytes.c
	$(call QL_HOST,$*) $(QL_DIR)/script/gen_wbytes.c -o $(@D)/gen_wbytes
	$(@D)/gen_wbytes > $@
$(QL_DIR)/data/ql_wl2.S: $(foreach p,$(QL_PHASES),$(QL_DIR)/$(p)/data/wbytes.txt)
	@{ echo '// GENERATED by qwen-layer/app.mk -- do not hand-edit.'; \
	   echo '  .section .l2_bss, "aw", @nobits'; \
	   echo '  .balign 65536'; \
	   echo '  .globl ql_w_l2'; echo 'ql_w_l2:'; \
	   echo "  .zero $$(cat $^ | sort -n | tail -1)"; \
	   for p in $(QL_PHASES); do echo "  .globl $${p}_w_l2"; echo "  .set $${p}_w_l2, ql_w_l2"; done; \
	} > $@
$(QL_DIR)/data/ql_wl2.S.o: $(QL_DIR)/data/ql_wl2.S
	$(RISCV_CC) $(RISCV_CCFLAGS) -c $< -o $@

# The GDN value self-test's reference (ql_gchk=1), else a stub.
$(QL_DIR)/data/ql_gchk.h: $(QL_DIR)/data/ql_knobs.h $(QL_DIR)/script/gen_gchk.py
	@mkdir -p $(@D)
	$(if $(filter 1,$(ql_gchk)),python3.12 $(QL_DIR)/script/gen_gchk.py $(ql_b) $(ql_t) $@,echo '// no GDN self-test (ql_gchk=0)' > $@)

QL_GEN = $(QL_DIR)/data/ql_knobs.h $(QL_DIR)/data/ql_joint.h $(QL_DIR)/data/ql_gchk.h \
	$(QL_DIR)/data/ql_a_qz.h $(QL_DIR)/data/ql_a_op.h \
	$(QL_DIR)/data/ql_a_gu.h $(QL_DIR)/data/ql_a_dn.h
QL_HDRS = $(QL_GEN) $(QL_DIR)/layer.h $(QL_COMMON)/qc_gdn.h $(QL_COMMON)/qc_layout.h \
	$(QL_COMMON)/qc_vec.h $(QL_COMMON)/qc_sync.h $(QL_COMMON)/qwen_phase.h
$(QL_DIR)/phase_qz.c.o: RISCV_CCFLAGS += -I$(abspath $(QL_DIR)/qz) -I$(abspath $(QL_COMMON))
$(QL_DIR)/phase_op.c.o: RISCV_CCFLAGS += -I$(abspath $(QL_DIR)/op) -I$(abspath $(QL_COMMON))
$(QL_DIR)/phase_qa.c.o: RISCV_CCFLAGS += -I$(abspath $(QL_DIR)/qa) -I$(abspath $(QL_COMMON))
$(QL_DIR)/phase_gu.c.o: RISCV_CCFLAGS += -I$(abspath $(QL_DIR)/gu) -I$(abspath $(QL_COMMON))
$(QL_DIR)/phase_dn.c.o: RISCV_CCFLAGS += -I$(abspath $(QL_DIR)/dn) -I$(abspath $(QL_COMMON))
$(QL_DIR)/mixer_gdn.c.o $(QL_DIR)/mixer_attn.c.o $(QL_DIR)/norms.c.o $(QL_DIR)/main.c.o: RISCV_CCFLAGS += -I$(abspath $(QL_COMMON))
QL_PHASE_DEPS = $(QL_HDRS) $(QL_COMMON)/qwen_phase.c $(QL_COMMON)/qwen_tu_prefix.h \
	$(QL_COMMON)/kernel/qwen-fmatmul.c $(QL_LAYOUT_DEPS)
$(QL_DIR)/phase_qz.c.o: $(QL_DIR)/qz/data/qwen_hash.h $(QL_PHASE_DEPS)
$(QL_DIR)/phase_op.c.o: $(QL_DIR)/op/data/qwen_hash.h $(QL_PHASE_DEPS)
$(QL_DIR)/phase_qa.c.o: $(QL_DIR)/qa/data/qwen_hash.h $(QL_PHASE_DEPS)
$(QL_DIR)/phase_gu.c.o: $(QL_DIR)/gu/data/qwen_hash.h $(QL_PHASE_DEPS) $(QL_COMMON)/swiglu.h
$(QL_DIR)/phase_dn.c.o: $(QL_DIR)/dn/data/qwen_hash.h $(QL_PHASE_DEPS)
$(QL_DIR)/mixer_gdn.c.o $(QL_DIR)/mixer_attn.c.o $(QL_DIR)/norms.c.o $(QL_DIR)/main.c.o: $(QL_HDRS) $(QL_COMMON)/qc_attn.h

.DEFAULT_GOAL := $(ql_saved_goal)
