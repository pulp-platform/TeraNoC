# ---- One linear stage of a Qwen decode layer (qwen-proj) ----------------------------------------
# Included by ../Makefile before its $(BINARIES) rule. docs/qwen3_8_27b/linear_bench_plan.md.
#
#   make qwen-proj config=terapool_spatz4_fpu icache_warmup=1 l1_bank_size=4096 l2_size=536870912 \
#        proj_shape=gu proj_b=16 [proj_steps=4]
#   make qwen-proj ... proj_shape=dn proj_b=4 proj_k=2048 proj_check=1     # exact check, small dims
#
# Shapes (canonical_shapes.md; kt_max as qwen-layer):
#   gu    FFN gate+up               4096 -> 16384, 2 projections
#   dn    FFN down                 16384 ->  4096
#   qkvz  GDN q+k+v+z               4096 -> 16384
#   qgkv  attention q+gate+k+v      4096 -> 14336
#   op    o-projection (GDN, attn)  6144 ->  4096
proj_saved_goal := $(.DEFAULT_GOAL)

# proj_steps: 0 = every K tile; n (even) = only the first n per (strip, projection).
# proj_check: 1 = exact end-to-end check on preloaded operands (use small dims).
# proj_report: min (default unless proj_check) = one hex result line, then exit | full = decimal
#   report lines ([PROJ], [FFN] ...); slow on RTL (~90 cycles a character of formatted numbers).
# proj_kgroup: K split across groups, auto | 0 | 1.
# Timing runs only (results are partial; script/proj_results.py extrapolates):
#   proj_strips: 0 = every output strip; n = only the first n.
#   proj_kt / proj_pt: 0 = auto; n = pin the K tile height / strip width (must be a legal candidate).
# proj_mshr: unset = normal build | 1 / 0 = ablation build with the group MSHR on / left disabled
#   all run (every remote load bypasses it). The two ablation builds have identical code and
#   layout, only the enable value differs; an unset build is the benchmark program.
proj_shape  ?= gu
proj_b      ?= 1
proj_steps  ?= 0
proj_check  ?= 0
proj_kgroup ?= auto
proj_rc_group ?= 4
proj_strips ?= 0
proj_kt     ?= 0
proj_pt     ?= 0
proj_mshr   ?=
proj_report ?= $(if $(filter 0,$(proj_check)),min,full)

proj_def_k      := $(if $(filter dn,$(proj_shape)),16384,$(if $(filter op,$(proj_shape)),6144,4096))
proj_def_p      := $(if $(filter dn op,$(proj_shape)),4096,$(if $(filter qgkv,$(proj_shape)),14336,16384))
proj_stages     := $(if $(filter gu,$(proj_shape)),2,1)
proj_k      ?= $(proj_def_k)
proj_p      ?= $(proj_def_p)
proj_kt_max ?= $(if $(filter dn op,$(proj_shape)),$(proj_k),640)

PROJ_DIR := qwen-proj
PROJ_COMMON := qwen-common
# qwen-layer's tiling generators (gen_cands.c, gen_joint.c) are reused as they are.
PROJ_LAYER := qwen-layer
proj_kg_req := $(if $(filter auto,$(proj_kgroup)),-1,$(proj_kgroup))

ifneq ($(filter qwen-proj,$(MAKECMDGOALS)),)
ifneq ($(strip $(proj_mshr)),)
ifeq ($(filter 0 1,$(proj_mshr)),)
$(error qwen-proj: proj_mshr must be 0, 1 or unset (got '$(proj_mshr)'))
endif
endif
ifeq ($(filter gu dn qkvz qgkv op,$(proj_shape)),)
$(error qwen-proj: proj_shape must be gu, dn, qkvz, qgkv or op (got '$(proj_shape)'))
endif
# proj_l1_spec=1: the L1-size study builds for the spec L1 (l1_bank_size=1024: 4 / 16 MiB).
ifneq ($(strip $(l1_bank_size)),$(if $(filter 1,$(proj_l1_spec)),1024,4096))
$(error qwen-proj: pass l1_bank_size=$(if $(filter 1,$(proj_l1_spec)),1024,4096) (got '$(strip $(l1_bank_size))'))
endif
ifneq ($(strip $(l2_size)),536870912)
$(error qwen-proj: pass l2_size=536870912 (got '$(strip $(l2_size))'))
endif
ifneq ($(proj_check),0)
ifneq ($(proj_steps)$(proj_strips),00)
$(error qwen-proj: a check build streams every K tile of every strip (proj_steps=0 proj_strips=0))
endif
ifeq ($(proj_report),min)
$(error qwen-proj: a check build reports in full (proj_report=full))
endif
endif
QWEN_EXTRA_OBJS += $(PROJ_DIR)/phase.c.o
ifeq ($(proj_check),1)
QWEN_EXTRA_OBJS += $(PROJ_DIR)/data/proj_operands.S.o
endif
endif

$(PROJ_DIR)/data/qwen_shape.h: FORCE
	@mkdir -p $(@D)
	@{ \
	  echo '// GENERATED by qwen-proj/app.mk -- do not hand-edit.'; \
	  echo '#ifndef QWEN_SHAPE_H'; \
	  echo '#define QWEN_SHAPE_H'; \
	  echo '// tile pins (cands.txt filter): kt=$(proj_kt) pt=$(proj_pt)'; \
	  echo '#define GEMM_M $(proj_b)'; \
	  echo '#define GEMM_N $(proj_k)'; \
	  echo '#define GEMM_P $(proj_p)'; \
	  echo '#define GEMM_ELEM_BYTES 2'; \
	  echo '#define QWEN_STAGES_N $(proj_stages)u'; \
	  echo '#define QWEN_CHECK $(proj_check)'; \
	  echo '#define QWEN_PRELOAD $(proj_check)'; \
	  echo '#define QWEN_INIT 0'; \
	  echo '#define QWEN_REPEATS 1'; \
	  echo '#define QWEN_DMA_CORE 0u'; \
	  echo '#define QWEN_KT_REQ 0'; \
	  echo '#define QWEN_KT_MAX $(proj_kt_max)'; \
	  echo '#define GEMM_KS_PREFER_MAX 1'; \
	  echo '#define QWEN_SPAN_ALIGN_DEFAULT 1'; \
	  echo '#define QWEN_PT_REQ 0'; \
	  echo '#define MATMUL_DECODE_SPLIT 1'; \
	  echo '#define GEMM_DECODE_RC_PER_GROUP $(proj_rc_group)'; \
	  echo '#define QWEN_WPAD_DEFAULT 1'; \
	  echo '#define QWEN_KSPLIT_REQ 0'; \
	  echo '#define QWEN_SWIGLU 0'; \
	  echo '#define QWEN_ACC32 0'; \
	  echo '#define FFN_KSPLIT_XGROUP_REQ $(proj_kg_req)'; \
	  echo '#define FFN_PRIME_SPLIT_REQ 1'; \
	  echo '#define FFN_HPAD_REQ -1'; \
	  echo '#define FFN_GU_PT_REQ 0'; \
	  echo '#define FFN_GU_WPAD_REQ -1'; \
	  $(if $(filter-out 0,$(proj_steps)),echo '#define QWEN_STEPS_RUN $(proj_steps)';) \
	  $(if $(filter 0 1,$(proj_mshr)),echo '#define QP_MSHR_ABL 1'; echo '#define QP_MSHR_ON $(proj_mshr)';) \
	  $(if $(filter-out 0,$(proj_strips)),echo '#define QWEN_STRIPS_RUN $(proj_strips)';) \
	  echo '#endif'; \
	} > $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; fi

$(PROJ_DIR)/data/proj_knobs.h: FORCE
	@mkdir -p $(@D)
	@{ \
	  echo '// GENERATED by qwen-proj/app.mk -- do not hand-edit.'; \
	  echo '#ifndef PROJ_KNOBS_H'; \
	  echo '#define PROJ_KNOBS_H'; \
	  echo '#define PROJ_BUILT_FOR "$(config) cores=$(num_cores) l1_bank=$(l1_bank_size) l2=$(l2_size) shape=$(proj_shape) b=$(proj_b) k=$(proj_k) p=$(proj_p) steps=$(proj_steps) strips=$(proj_strips) kt=$(proj_kt) pt=$(proj_pt) check=$(proj_check) report=$(proj_report) kgroup=$(proj_kgroup)"'; \
	  echo '#define PROJ_SHAPE "$(proj_shape)"'; \
	  echo '#define PROJ_B $(proj_b)u'; \
	  echo '#define PROJ_K $(proj_k)u'; \
	  echo '#define PROJ_P $(proj_p)u'; \
	  echo '#define PROJ_STAGES $(proj_stages)u'; \
	  echo '#define PROJ_STEPS_KNOB $(proj_steps)u'; \
	  echo '#define PROJ_CHECK $(proj_check)'; \
	  echo '#define PROJ_REPORT_MIN $(if $(filter min,$(proj_report)),1,0)'; \
	  echo '#endif'; \
	} > $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; fi

PROJ_HOST_CC ?= cc
PROJ_HOST = $(PROJ_HOST_CC) -O1 -I$(RUNTIME_DIR) -I$(PROJ_DIR) -I$(PROJ_COMMON) \
	-I$(PROJ_COMMON)/script $(DEFINES)
PROJ_LAYOUT_DEPS = $(PROJ_COMMON)/qwen_layout.h $(RUNTIME_DIR)/gemm_config.h $(RUNTIME_DIR)/gemm_burst.h

# Every legal (KT, PT), then the best one alone in L1 (qwen-layer's generators, one phase, no
# mixer reserve): the tallest K tile and widest strip that fit.
$(PROJ_DIR)/data/cands.txt: $(PROJ_DIR)/data/qwen_shape.h $(PROJ_LAYOUT_DEPS) $(PROJ_LAYER)/script/gen_cands.c
	$(PROJ_HOST) $(PROJ_LAYER)/script/gen_cands.c -o $(@D)/gen_cands
	$(@D)/gen_cands > $@.tmp
	@# proj_kt / proj_pt pin the choice: keep the L1 line and the matching candidates only.
	awk 'NR == 1 || (($(proj_kt) == 0 || $$1 == $(proj_kt)) && ($(proj_pt) == 0 || $$2 == $(proj_pt)))' \
		$@.tmp > $@.flt && rm $@.tmp && mv $@.flt $@
	@test $$(wc -l < $@) -gt 1 || { echo "qwen-proj: no legal tile for kt=$(proj_kt) pt=$(proj_pt)"; exit 1; }
$(PROJ_DIR)/data/proj_joint.h: $(PROJ_DIR)/data/cands.txt $(PROJ_LAYER)/script/gen_joint.c
	$(PROJ_HOST_CC) -O1 $(PROJ_LAYER)/script/gen_joint.c -o $(@D)/gen_joint -lm
	$(@D)/gen_joint $@ 0 0 proj $(PROJ_DIR)/data/cands.txt $(PROJ_DIR)/data/qwen_tiles.h
$(PROJ_DIR)/data/qwen_tiles.h: $(PROJ_DIR)/data/proj_joint.h

$(PROJ_DIR)/data/qwen_hash.h: $(PROJ_DIR)/data/qwen_tiles.h $(PROJ_LAYOUT_DEPS) \
	$(PROJ_COMMON)/script/gen_hash.c $(RUNTIME_DIR)/gemm_hash.h
	$(PROJ_HOST) $(PROJ_COMMON)/script/gen_hash.c -o $(@D)/gen_hash
	$(@D)/gen_hash > $@

# Check builds: X and every W[s], preloaded in L2 (script/gen_operands.c).
$(PROJ_DIR)/data/operands.done: $(PROJ_DIR)/data/qwen_tiles.h $(PROJ_LAYOUT_DEPS) \
	$(PROJ_COMMON)/qwen_pattern.h $(PROJ_DIR)/script/gen_operands.c
	$(PROJ_HOST) -O2 $(PROJ_DIR)/script/gen_operands.c -o $(@D)/gen_operands
	$(@D)/gen_operands $(abspath $(@D)) && touch $@
$(PROJ_DIR)/data/proj_operands.S: $(PROJ_DIR)/data/operands.done
	@{ echo '// GENERATED by qwen-proj/app.mk -- do not hand-edit.'; \
	   echo '  .section .l2, "a", @progbits'; \
	   for s in pj_w_l2 pj_x_l2; do \
	     echo "  .balign $$(cat $(PROJ_DIR)/data/align.txt)"; \
	     echo "  .globl $$s"; echo "$$s:"; \
	     echo "  .incbin \"$(abspath $(PROJ_DIR))/data/$$s.bin\""; \
	   done; } > $@
$(PROJ_DIR)/data/proj_operands.S.o: $(PROJ_DIR)/data/proj_operands.S
	$(RISCV_CC) $(RISCV_CCFLAGS) -c $< -o $@

PROJ_GEN = $(PROJ_DIR)/data/proj_joint.h $(PROJ_DIR)/data/proj_knobs.h $(PROJ_DIR)/data/qwen_hash.h
$(PROJ_DIR)/phase.c.o: RISCV_CCFLAGS += -I$(abspath $(PROJ_DIR)) -I$(abspath $(PROJ_COMMON))
$(PROJ_DIR)/main.c.o: RISCV_CCFLAGS += -I$(abspath $(PROJ_COMMON))
$(PROJ_DIR)/phase.c.o: $(PROJ_GEN) $(PROJ_DIR)/proj.h $(PROJ_COMMON)/qwen_phase.c \
	$(PROJ_COMMON)/qwen_phase.h $(PROJ_COMMON)/qwen_tu_prefix.h \
	$(PROJ_COMMON)/kernel/qwen-fmatmul.c $(PROJ_COMMON)/qwen_pattern.h $(PROJ_LAYOUT_DEPS)
$(PROJ_DIR)/main.c.o: $(PROJ_GEN) $(PROJ_DIR)/proj.h $(PROJ_COMMON)/qwen_phase.h

.DEFAULT_GOAL := $(proj_saved_goal)
