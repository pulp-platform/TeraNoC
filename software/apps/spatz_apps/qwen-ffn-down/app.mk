# ---- Qwen FFN down projection (qwen-ffn-down) ---------------------------------------
# Included by ../Makefile BEFORE its $(BINARIES) rule, whose prerequisite list (and so
# QWEN_EXTRA_OBJS) is expanded when that rule is parsed. Everything this app needs lives
# here; variables are ffn_* so they never collide with qwen-gate-up's qwen_*.
#
# Same scheme as qwen-gate-up: the shape is a make variable written into a generated
# header, because gemm_config.h (KERNEL_SIZE, split) and mshr_cfg.h (MSHR tuning) derive
# from GEMM_M/N/P at COMPILE time.
#
#   make qwen-ffn-down config=terapool_spatz4_fpu icache_warmup=1 l2_size=536870912 ffn_b=16
#   make qwen-ffn-down ... ffn_b=1 ffn_k=2048 ffn_check=1 ffn_preload=1   # self-checking
#
# Canonical shape (docs/qwen3_8_27b/canonical_shapes.md): Y[B,4096] = H[B,16384] . W[16384,4096].
# Included before ../Makefile's first target: keep ours from becoming the default goal.
ffn_saved_goal := $(.DEFAULT_GOAL)

ffn_b       ?= 1
ffn_k       ?= 16384
ffn_p       ?= 4096
# Reduction rows of W per streamed K tile. `auto` = the tallest KT = K/s (s even) whose
# double buffer fits L1 beside everything else, up to ffn_kt_max (default: no cap, K).
ffn_kt      ?= auto
ffn_kt_max  ?= $(ffn_k)
# 0 = perf, 1 = multi-hot (addressing + every K part), 2 = ones (needs K <= 2048, 2^n),
# 3 = SwiGLU against a host reference (needs ffn_swiglu=1 ffn_preload=1).
ffn_check   ?= 0
# 1 = H = SiLU(G) * U computed on the target from G, U in L2 (the gate/up output layout);
# 0 = H loaded directly (step 1 of the plan).
ffn_swiglu  ?= 1
# Layout of G and U in L2, as qwen-gate-up writes them: [strip][B][gu_pt + gu_wpad].
# auto = one strip of K columns; gu_wpad default = one 64-byte stripe (gate-up's row pad).
ffn_gu_pt   ?= auto
ffn_gu_wpad ?= tile
# H row pad in elements (qwen_layout.h "H row pad"): auto = one L1 group stride, 0 = none.
ffn_hpad    ?= auto
ffn_init    ?= 0
ffn_dma_core ?= 0
ffn_preload ?= 0
ffn_repeats ?= 1
# Kernel rows: `max` = largest legal (gate-up default), `score`, or 1|2|4|8.
ffn_ks      ?= max
ffn_span_align ?= stripe
ffn_pt      ?= auto
# Default `decode` for every batch: prefill would make every group read all of W.
ffn_split   ?= decode
ffn_rc_group ?= 4
ffn_wpad    ?= tile
ffn_ksplit  ?= auto
# Accumulation: 16 = fp16 C all the way (default); 32 = fp16 FMAs within a kernel call, flushed
# into an fp32 C every call and rounded to fp16 once at the end (parked: not bit-exact on RTL).
ffn_acc     ?= 16
# First W tile fetched in this many pieces so compute starts after the first one lands
# (SwiGLU builds only). auto = 4, else 2, else 1, keeping >= 16 even rows per core per piece.
ffn_prime_split ?= auto
# K split across groups (each group one K part), so the H loads keep >= 4 sharers per group.
# auto = on when the in-group split leaves < 3 (8x8 B=16..64, 4x4 B<=4; never with ffn_acc=32);
# 1 / 0 force it.
ffn_kgroup  ?= auto

# Every measurement in this project uses the SIMULATED memory sizes (user decision
# 2026-09-28): 4 KiB banks (16 MiB L1 at 4x4, 64 MiB at 8x8) and a 512 MiB L2. The
# committed config/config.mk still says 1024, and the RTL images were built with 4096, so
# an ELF built without these would silently disagree with the hardware it runs on.
ifneq ($(filter qwen-ffn-down,$(MAKECMDGOALS)),)
ifneq ($(strip $(l1_bank_size)),4096)
$(error qwen-ffn-down: pass l1_bank_size=4096 (got '$(strip $(l1_bank_size))'))
endif
ifneq ($(strip $(l2_size)),536870912)
$(error qwen-ffn-down: pass l2_size=536870912 (got '$(strip $(l2_size))'))
endif
endif

ifeq ($(ffn_preload),1)
QWEN_EXTRA_OBJS += qwen-ffn-down/data/qwen_operands.S.o
endif

ifeq ($(ffn_span_align),stripe)
ffn_span_def := QWEN_SPAN_ALIGN_DEFAULT 1
else
ffn_span_def := QWEN_SPAN_ALIGN $(ffn_span_align)
endif
ifeq ($(ffn_pt),auto)
ffn_pt_def := QWEN_PT_REQ 0
else
ffn_pt_def := QWEN_PT_REQ $(ffn_pt)
endif
ifeq ($(ffn_rc_group),group)
ffn_rc_def := QWEN_RC_GROUP_LEGACY 1
else
ffn_rc_def := GEMM_DECODE_RC_PER_GROUP $(ffn_rc_group)
endif
ifeq ($(ffn_wpad),tile)
ffn_wpad_def := QWEN_WPAD_DEFAULT 1
else
ffn_wpad_def := QWEN_WPAD $(ffn_wpad)
endif
ifeq ($(ffn_split),decode)
ffn_split_def := MATMUL_DECODE_SPLIT 1
else ifeq ($(ffn_split),prefill)
ffn_split_def := MATMUL_DECODE_SPLIT 0
else
ffn_split_def := QWEN_SPLIT_AUTO 1
endif
ifeq ($(ffn_ks),max)
ffn_ks_def := GEMM_KS_PREFER_MAX 1
else ifeq ($(ffn_ks),score)
ffn_ks_def := GEMM_KS_PREFER_MAX 0
else
ffn_ks_def := KERNEL_SIZE $(ffn_ks)
endif

qwen-ffn-down/data/qwen_shape.h: FORCE
	@mkdir -p $(@D)
	@{ \
	  echo '// GENERATED by qwen-ffn-down/app.mk from ffn_* make vars -- do not hand-edit.'; \
	  echo '#ifndef QWEN_SHAPE_H'; \
	  echo '#define QWEN_SHAPE_H'; \
	  echo '#define QWEN_OP_DOWN 1'; \
	  echo '// The machine is part of the shape: qwen_tiles.h / qwen_hash.h are regenerated only when'; \
	  echo '// this file changes, and the same B/K/P on another mesh must not reuse them.'; \
	  echo '#define FFN_BUILT_FOR "$(config) cores=$(num_cores) groups=$(num_groups) l1_bank=$(l1_bank_size) l2=$(l2_size)"'; \
	  echo '#define GEMM_M $(ffn_b)          // batch: independent decode sequences'; \
	  echo '#define GEMM_N $(ffn_k)          // FFN intermediate (reduction)'; \
	  echo '#define GEMM_P $(ffn_p)          // hidden (output)'; \
	  echo '#define GEMM_ELEM_BYTES 2'; \
	  echo '#define QWEN_KT_REQ $(if $(filter auto,$(ffn_kt)),0,$(ffn_kt))  // K tile rows, 0 = auto'; \
	  echo '#define QWEN_KT_MAX $(ffn_kt_max)'; \
	  echo '#define QWEN_CHECK $(ffn_check)'; \
	  echo '#define QWEN_INIT $(ffn_init)'; \
	  echo '#define QWEN_DMA_CORE $(ffn_dma_core)u'; \
	  echo '#define QWEN_PRELOAD $(ffn_preload)'; \
	  echo '#define QWEN_REPEATS $(ffn_repeats)'; \
	  echo '#define $(ffn_ks_def)'; \
	  echo '#define $(ffn_span_def)'; \
	  echo '#define $(ffn_pt_def)'; \
	  echo '#define $(ffn_split_def)'; \
	  echo '#define $(ffn_rc_def)'; \
	  echo '#define $(ffn_wpad_def)'; \
	  echo '#define QWEN_KSPLIT_REQ $(if $(filter auto,$(ffn_ksplit)),0,$(ffn_ksplit))  // 0 = auto'; \
	  echo '#define QWEN_SWIGLU $(ffn_swiglu)'; \
	  echo '#define QWEN_ACC32 $(if $(filter 16,$(ffn_acc)),0,1)  // ffn_acc=$(ffn_acc)'; \
	  echo '#define FFN_KSPLIT_XGROUP_REQ $(if $(filter auto,$(ffn_kgroup)),-1,$(ffn_kgroup))  // -1 = auto'; \
	  echo '#define FFN_PRIME_SPLIT_REQ $(if $(filter auto,$(ffn_prime_split)),0,$(ffn_prime_split))  // 0 = auto'; \
	  echo '#define FFN_HPAD_REQ $(if $(filter auto,$(ffn_hpad)),-1,$(ffn_hpad))  // -1 = auto'; \
	  echo '#define FFN_GU_PT_REQ $(if $(filter auto,$(ffn_gu_pt)),0,$(ffn_gu_pt))  // 0 = K'; \
	  echo '#define FFN_GU_WPAD_REQ $(if $(filter tile,$(ffn_gu_wpad)),-1,$(ffn_gu_wpad))  // -1 = one stripe'; \
	  echo '#endif'; \
	} > $@.tmp
	@if cmp -s $@.tmp $@; then rm -f $@.tmp; else mv $@.tmp $@; fi

FFN_HOST_CC ?= cc
qwen-ffn-down/data/qwen_tiles.h: qwen-ffn-down/data/qwen_shape.h \
	qwen-ffn-down/qwen_layout.h qwen-ffn-down/script/gen_tiles.c \
	$(RUNTIME_DIR)/gemm_config.h $(RUNTIME_DIR)/gemm_burst.h
	@mkdir -p $(@D)
	$(FFN_HOST_CC) -O1 -I$(RUNTIME_DIR) -Iqwen-ffn-down $(DEFINES) \
		qwen-ffn-down/script/gen_tiles.c -o $(@D)/gen_tiles
	$(@D)/gen_tiles > $@.tmp && mv $@.tmp $@

qwen-ffn-down/data/qwen_hash.h: qwen-ffn-down/data/qwen_shape.h qwen-ffn-down/data/qwen_tiles.h \
	qwen-ffn-down/qwen_layout.h qwen-ffn-down/script/gen_hash.c \
	$(RUNTIME_DIR)/gemm_hash.h $(RUNTIME_DIR)/gemm_config.h $(RUNTIME_DIR)/gemm_burst.h
	@mkdir -p $(@D)
	$(FFN_HOST_CC) -O1 -I$(RUNTIME_DIR) -Iqwen-ffn-down $(DEFINES) \
		qwen-ffn-down/script/gen_hash.c -o $(@D)/gen_hash
	$(@D)/gen_hash > $@

qwen-ffn-down/data/qwen_operands.S: qwen-ffn-down/data/qwen_shape.h qwen-ffn-down/data/qwen_tiles.h \
	qwen-ffn-down/qwen_layout.h qwen-ffn-down/qwen_pattern.h \
	qwen-ffn-down/script/gen_operands.c qwen-ffn-down/script/fp16_host.h
	@mkdir -p $(@D)
	$(FFN_HOST_CC) -O2 -I$(RUNTIME_DIR) -Iqwen-ffn-down $(DEFINES) \
		qwen-ffn-down/script/gen_operands.c -o $(@D)/gen_operands -lm
	$(@D)/gen_operands $(@D)

qwen-ffn-down/data/qwen_operands.S.o: qwen-ffn-down/data/qwen_operands.S
	$(RISCV_CC) $(RISCV_CCFLAGS) -c $< -o $@

qwen-ffn-down/main.c.o: qwen-ffn-down/data/qwen_shape.h qwen-ffn-down/data/qwen_tiles.h \
	qwen-ffn-down/data/qwen_hash.h \
	qwen-ffn-down/qwen_layout.h qwen-ffn-down/qwen_pattern.h qwen-ffn-down/swiglu.h \
	qwen-ffn-down/kernel/qwen-fmatmul.c qwen-ffn-down/kernel/qwen-fmatmul.h

.DEFAULT_GOAL := $(ffn_saved_goal)
